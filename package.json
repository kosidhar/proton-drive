{
    "name": "kosidhar-protondrive",
    "private": true,
    "version": "0.1.1",
    "description": "Unofficial Proton Drive client for Ubuntu/Linux powered by Proton Drive SDK",
    "license": "MIT",
    "main": "src/cli/main.ts",
    "bin": {
        "protondrive": "./src/cli/main.ts"
    },
    "engines": {
        "bun": ">=1.4.2"
    },
    "scripts": {
        "set-version": "bun scripts/set-version.ts",
        "start": "bun run src/cli/main.ts",
        "daemon": "bun run src/cli/main.ts daemon",
        "gui": "bun run src/cli/main.ts gui",
        "build": "bun ./scripts/build.ts",
        "build:deb": "bash ./packaging/linux/package.sh --formats deb",
        "package:linux": "bash ./packaging/linux/package.sh",
        "install:user": "bash ./packaging/linux/install.sh --user",
        "check-types": "bunx tsc --noEmit",
        "test": "bun test tests"
    },
    "dependencies": {
        "@boltffi/runtime": "0.31.0",
        "@noble/hashes": "^1.8.0",
        "@protontech/crypto": "2.0.0",
        "@protontech/drive-sdk": "file:./vendor/sdk/client/js",
        "@sentry/bun": "^10.73.0",
        "@xmldom/xmldom": "^0.9.12",
        "comlink": "^4.4.2",
        "exifreader": "^4.44.0",
        "ky": "^1.14.3",
        "proton-drive-sdk-account": "file:./vendor/sdk/incubating/account/js",
        "ttag": "^1.8.7"
    },
    "devDependencies": {
        "@protontech/global-types": "^1.0.0",
        "@types/bun": "^1.4.2",
        "bun-types": "^1.4.2",
        "typescript": "^5.9.3"
    },
    "patchedDependencies": {
        "@protontech/crypto@2.0.0": "./vendor/sdk/config/js/patches/@protontech%2Fcrypto@2.0.0.patch"
    }
}
