[Desktop Entry]
Version=1.0
Type=Application
Name=Proton Drive
GenericName=Proton Drive
Comment=Proton Drive desktop sync client for Ubuntu
Exec=/usr/bin/protondrive gui
Icon=protondrive
Terminal=false
