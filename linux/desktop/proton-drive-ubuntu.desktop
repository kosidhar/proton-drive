[Desktop Entry]
Version=1.0
Type=Application
Name=Ubuntu Cloud Sync (Unofficial for Proton Drive)
GenericName=Cloud Drive Sync
Comment=Third-party two-way folder sync client powered by Proton Drive SDK (Not officially supported by Proton)
Exec=/usr/bin/proton-drive-ubuntu gui
Icon=proton-drive-ubuntu
Terminal=false
Categories=Network;FileTransfer;Utility;
