[Desktop Entry]
Type=Service
MimeType=inode/directory;all/allfiles;
Actions=ProtonDriveSyncNow;ProtonDriveOpenGui;
X-KDE-Priority=TopLevel
X-KDE-Submenu=Proton Drive

[Desktop Action ProtonDriveSyncNow]
Name=Sync Now
Icon=io.github.kosidhar.ProtonDrive
Exec=protondrive sync

[Desktop Action ProtonDriveOpenGui]
Name=Status & Settings…
Icon=io.github.kosidhar.ProtonDrive
Exec=protondrive-gui --tab home
