[Unit]
Description=Unofficial Proton Drive Two-Way Sync Daemon for Ubuntu
Documentation=https://github.com/gautamchauhan/proton-drive
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/proton-drive-ubuntu daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
