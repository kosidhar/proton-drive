# Maintainer: Gautam Chauhan <gautam@linux.local>
pkgname=kosidhar-protondrive
pkgver=0.1.0
pkgrel=1
pkgdesc="Native Linux desktop client and two-way folder sync daemon for Proton Drive"
arch=('x86_64' 'aarch64')
url="https://github.com/kosidhar/proton-drive"
license=('MIT')
depends=('glibc' 'gcc-libs' 'libxkbcommon' 'vulkan-icd-loader' 'hicolor-icon-theme' 'fuse3')
optdepends=(
  'glib2: gio, used to move files to the desktop Trash'
  'libsecret: OS Keyring credential storage via Freedesktop Secret Service'
  'libnotify: Desktop sync and conflict notifications'
  'nautilus-python: GNOME Files (Nautilus) context menu and sync emblem integration'
  'nemo-python: Cinnamon (Nemo) context menu and sync emblem integration'
  'dolphin: KDE Plasma Dolphin service menu integration'
)
source=("kosidhar-protondrive-${pkgver}-linux-${CARCH}.tar.gz")
sha256sums=('SKIP')

package() {
  cp -a "${srcdir}/kosidhar-protondrive-${pkgver}-linux-${CARCH}/"* "${pkgdir}/usr/"
}
